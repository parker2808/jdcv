{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": { "type": "number", "const": 1 },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": {
            "type": "object",
            "properties": {
              "en": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "vi": { "type": "string", "minLength": 1, "pattern": "\\S" }
            },
            "required": ["en", "vi"],
            "additionalProperties": false
          }
        },
        "required": ["id", "title"],
        "additionalProperties": false
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "section": {
            "type": "string",
            "enum": [
              "jd",
              "concepts",
              "interview",
              "pitch",
              "rescue",
              "ask",
              "cheat"
            ]
          },
          "jdRequirement": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "title": {
            "type": "object",
            "properties": {
              "en": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "vi": { "type": "string", "minLength": 1, "pattern": "\\S" }
            },
            "required": ["en", "vi"],
            "additionalProperties": false
          },
          "shortAnswer": {
            "type": "object",
            "properties": {
              "en": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "vi": { "type": "string", "minLength": 1, "pattern": "\\S" }
            },
            "required": ["en", "vi"],
            "additionalProperties": false
          },
          "keyPoints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "en": { "type": "string", "minLength": 1, "pattern": "\\S" },
                "vi": { "type": "string", "minLength": 1, "pattern": "\\S" }
              },
              "required": ["en", "vi"],
              "additionalProperties": false
            }
          },
          "detail": {
            "type": "object",
            "properties": {
              "en": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "vi": { "type": "string", "minLength": 1, "pattern": "\\S" }
            },
            "required": ["en", "vi"],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "section",
          "jdRequirement",
          "tags",
          "title",
          "shortAnswer",
          "keyPoints",
          "detail"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "requirements", "entries"],
  "additionalProperties": false,
  "x-jdcv-integrity": "module"
}
