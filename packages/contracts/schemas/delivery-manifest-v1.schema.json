{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": { "type": "number", "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "cvVersionId": { "type": "string", "minLength": 1 },
    "ownerId": { "type": "string", "minLength": 1 },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "diff": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": {
            "type": "string",
            "pattern": "^experience\\.\\d+\\.projects\\.\\d+\\.bullets\\.\\d+\\.text\\.(en|vi)$"
          },
          "before": { "type": "string", "minLength": 1 },
          "after": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "requirementId": { "type": "string", "minLength": 1 },
          "sourceRef": { "type": "string", "pattern": "^cv:paragraph:\\d+$" },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] },
          "riskNote": { "type": "string", "minLength": 1 },
          "interviewAnswer": { "type": "string", "minLength": 1 },
          "defenseEntryId": { "type": "string", "minLength": 1 },
          "change": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "employer",
                      "title",
                      "date",
                      "project",
                      "credential",
                      "experienceYears"
                    ]
                  }
                },
                "required": ["kind"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["wording", "projectDetail", "estimate"]
                  },
                  "projectId": { "type": "string", "minLength": 1 },
                  "requirementId": { "type": "string", "minLength": 1 },
                  "sourceRef": { "type": "string", "minLength": 1 },
                  "technology": { "type": "string", "minLength": 1 },
                  "technologyAvailableSince": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "estimateAuthorized": { "type": "boolean" },
                  "estimateRangeDocumented": { "type": "boolean" },
                  "roleAndTeamScopeSupported": { "type": "boolean" }
                },
                "required": [
                  "kind",
                  "projectId",
                  "requirementId",
                  "sourceRef",
                  "roleAndTeamScopeSupported"
                ],
                "additionalProperties": false
              }
            ]
          },
          "embellishment": { "type": "boolean" },
          "decision": { "type": "string", "enum": ["approved", "rejected"] },
          "defenseScore": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 5 },
              { "type": "null" }
            ]
          },
          "criticalFindings": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "path",
          "before",
          "after",
          "reason",
          "requirementId",
          "sourceRef",
          "risk",
          "riskNote",
          "interviewAnswer",
          "defenseEntryId",
          "change",
          "embellishment",
          "decision",
          "defenseScore",
          "criticalFindings"
        ],
        "additionalProperties": false
      }
    },
    "approval": {
      "type": "object",
      "properties": {
        "cvVersionId": { "type": "string", "minLength": 1 },
        "approvedVersionId": { "type": "string", "minLength": 1 },
        "embellishments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["approved", "rejected"] },
              "lineApproved": { "type": "boolean" },
              "defenseEntryId": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              },
              "defenseScore": {
                "anyOf": [
                  { "type": "number", "minimum": 0, "maximum": 5 },
                  { "type": "null" }
                ]
              },
              "criticalFindings": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "status",
              "lineApproved",
              "defenseEntryId",
              "defenseScore",
              "criticalFindings"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["cvVersionId", "approvedVersionId", "embellishments"],
      "additionalProperties": false
    },
    "docx": {
      "type": "object",
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[^./\\\\][^/\\\\]*\\.docx$"
        },
        "size": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["fileName", "size", "sha256"],
      "additionalProperties": false
    },
    "pdf": {
      "type": "object",
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[^./\\\\][^/\\\\]*\\.pdf$"
        },
        "size": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["fileName", "size", "sha256"],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "jobId",
    "cvVersionId",
    "ownerId",
    "createdAt",
    "diff",
    "approval",
    "docx",
    "pdf"
  ],
  "additionalProperties": false,
  "x-jdcv-integrity": "delivery-manifest"
}
